	"changesets": [
		{
			"path": ".changeset/1787912326-monopi-provider-ollama.md",
			"summary": "Pin glm-5.3-flash Ollama Cloud metadata floor to the full 1M context window",
			"details": "glm-5.3-flash was missing from the Ollama Cloud metadata override catalog (the list stopped at glm-5.2). Discovery normally picks up the correct 1,048,576-token context length from the /api/show endpoint, but without a floor entry a stale credential cache or an API metadata gap would silently fall back to the 128k default and trigger premature compaction. Adds the authoritative floor (contextWindow 1,048,576, maxTokens 131,072, reasoning) plus tests covering fresh normalization and stale-cache repair.",
			"targets": [
				{
					"id": "monopi-group",
					"kind": "group",
					"bump": "patch",
					"origin": "direct-change",
					"evidence_refs": [],
					"change_type": "patch"
				}
			],
			"context": {
				"provider": "github",
				"host": "github.com",
				"capabilities": {
					"commit_web_urls": true,
					"actor_profiles": true,
					"review_request_lookup": true,
					"related_issues": true,
					"issue_comments": true
				},
				"introduced": {
					"actor": {
						"provider": "github",
						"host": "github.com",
						"id": null,
						"login": null,
						"display_name": "Ifiok Jr.",
						"url": null,
